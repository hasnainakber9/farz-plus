# Supabase public values
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Legacy alias accepted for older projects
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase key. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Corti server-only configuration. Live PHI stays disabled until compliance approval.
CORTI_ENVIRONMENT=eu
CORTI_TENANT=base
CORTI_CLIENT_ID=
CORTI_CLIENT_SECRET=
CORTI_AGENT_ID=
CORTI_ENABLED=false
CORTI_LIVE_PHI_ENABLED=false
CORTI_DPA_APPROVED=false
CORTI_TRANSFER_APPROVED=false

# Public runtime
NEXT_PUBLIC_APP_URL=https://farz-plus.vercel.app
NEXT_PUBLIC_EMERGENCY_NUMBER=1122
